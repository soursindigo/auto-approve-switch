{
  "name": "auto-approve-switch",
  "version": "0.5.1",
  "description": "DSH 本地插件：拦截 tools/pre-execute 自动放行工具调用，并用全局快捷键（⌘⌥A / Ctrl+Alt+A）随时开关。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.0 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs client && tsc -p tsconfig.json",
    "build:client": "node scripts/build.mjs client",
    "build:host": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && node scripts/build.mjs client --check",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm run test",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.5",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "zod": "4.4.3"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "auto-approve"
  ],
  "homepage": "https://github.com/soursindigo/auto-approve-switch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soursindigo/auto-approve-switch.git"
  },
  "bugs": {
    "url": "https://github.com/soursindigo/auto-approve-switch/issues"
  }
}
